{
  "name": "vektora",
  "version": "0.4.0",
  "private": true,
  "description": "VEKTORA — plataforma autónoma de resultados: planificación por DAG, matching híbrido y verificación por reputación de evidencia.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:check": "tsx scripts/ai-check.ts",
    "ai:models": "tsx scripts/ai-models.ts",
    "db:check": "tsx scripts/db-check.ts",
    "skills:embed": "tsx scripts/skills-embed.ts",
    "skills:calibrate": "tsx scripts/skills-calibrate.ts",
    "provider:add": "tsx scripts/provider-add.ts",
    "provider:seed": "tsx scripts/provider-seed.ts",
    "match": "tsx scripts/match-task.ts",
    "qa": "tsx scripts/qa-review.ts",
    "cron": "tsx scripts/cron-local.ts",
    "deliver": "tsx scripts/deliverable-submit.ts",
    "plan": "tsx scripts/plan-project.ts",
    "verify": "npm run typecheck && npm run test && npm run sql:check",
    "sql:build": "tsx scripts/sql-build.ts",
    "sql:check": "tsx scripts/sql-build.ts --check",
    "sql:aplicar": "tsx scripts/sql-aplicar.ts",
    "cuenta:admin": "tsx scripts/cuenta-admin.ts",
    "test:integracion": "vitest run tests/integracion",
    "db:configurar": "tsx scripts/configurar-db.ts",
    "render:env": "tsx scripts/render-env.ts",
    "k8s:secreto": "tsx scripts/k8s-secreto.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
