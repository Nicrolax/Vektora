# --- Dependencias -------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# --- Entorno y credenciales: NUNCA se versionan ---------------------------------------
# `.env` tiene la contraseña de la base, AUTH_SECRET, CRON_SECRET y las claves de IA.
# `.env.example` (solo nombres, sin valores) sí se sube.
.env
.env.*
!.env.example
# Secret real de Kubernetes (el repo solo lleva k8s/secret.yaml.example).
k8s/secret.yaml
# Certificados (el CA de Aiven va en DB_SSL_CA, nunca como archivo en el repo).
*.pem
*.crt
*.key

# Perfiles de proveedor para `npm run provider:add`: llevan datos personales reales.
perfil.json
perfil-*.json

# --- Build y caché -------------------------------------------------------------------
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/

# --- Pruebas -------------------------------------------------------------------------
coverage/
.vitest/

# --- Sistema y editores --------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json

# --- Capturas y salidas de la sesión de desarrollo -----------------------------------
# Capturas usadas para revisar la interfaz. No son parte del proyecto entregable.
Claude outputs/

# --- Configuración local de Claude Code -----------------------------------------------
.claude/
