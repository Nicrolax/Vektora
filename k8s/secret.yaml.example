# VEKTORA — Secret de EJEMPLO (Nivel 3). NO tiene valores reales.
#
# Para usarlo:
#   cp k8s/secret.yaml.example k8s/secret.yaml     # k8s/secret.yaml está en .gitignore
#   (reemplazar cada CAMBIAR-… por un valor real)
#   kubectl apply -f k8s/secret.yaml
#
# O generarlo sin escribir nada a mano (valores aleatorios):  npm run k8s:secreto
#
# `stringData` acepta texto plano y Kubernetes lo guarda codificado en base64. Ojo: base64
# NO es cifrado; lo que protege al Secret es el control de acceso del clúster y que este
# archivo con valores reales nunca se suba al repositorio.
apiVersion: v1
kind: Secret
metadata:
  name: vektora-secret
  labels:
    app.kubernetes.io/part-of: vektora
type: Opaque
stringData:
  # La base las usa para crear el usuario; la app, para conectarse. Tienen que coincidir.
  POSTGRES_USER: vektora
  POSTGRES_PASSWORD: CAMBIAR-contrasena-de-la-base
  DB_USER: vektora
  DB_PASSWORD: CAMBIAR-contrasena-de-la-base
  # Firma de la cookie de sesión: 64 caracteres al azar (openssl rand -hex 32).
  AUTH_SECRET: CAMBIAR-por-64-caracteres-aleatorios-0000000000000000000000000000
  # Secreto de los disparadores de los agentes (/api/cron/*).
  CRON_SECRET: CAMBIAR-por-otro-valor-aleatorio
  # Opcionales: sin ellas la demo funciona, pero no se crean proyectos nuevos.
  GROQ_API_KEY: ""
  GOOGLE_AI_API_KEY: ""
